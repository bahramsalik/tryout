{
  "name": "tryout-api",
  "version": "0.1.0",
  "private": true,
  "description": "Tryout API: shared live backend (REST + SSE) for the student and employer sites.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch --clear-screen=false --include \"../shared/**/*.ts\" src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed-cli.ts",
    "check-content": "tsx src/check-content.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx smoke/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
