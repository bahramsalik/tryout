# Copy this file to server/.env and fill it in. server/.env is git-ignored: never commit a real key.

# API key for the AI that grades submissions (leave empty to keep using the placeholder grader).
ANTHROPIC_API_KEY=

# Model used for grading. A small, cheap model is plenty for rubric scoring, e.g. claude-haiku-5-5.
GRADER_MODEL=claude-haiku-5-5

# Cost guard: most AI gradings allowed per day. Past this, new submissions wait for a later day.
GRADER_DAILY_LIMIT=200
